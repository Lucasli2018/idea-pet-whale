<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.dsh</groupId>
    <artifactId>dsh-pet-whale</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>DSH Pet Whale</name>
    <description>Whale-girl desktop pet for JetBrains IDEA 2023.1+ — animated by editor/build/test/VCS state. Compatible with IntelliJ IDEA 2023.1+ (since-build 231, runs on 2023.1 / 2023.3 / 2024.x / 2025.x).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- JBR 17 / IDEA 2023.1 起自带，平台字节码版本 61 -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- 面向的 IDE 产品版本 / IntelliJ Platform 各模块制品版本号。
             选 231 作为编译基线 = 最低支持 2023.1，仅使用 2023.1 起就存在的 API，
             从而在 2023.1 / 2023.3 / 2024.x / 2025.x 上都能运行。 -->
        <platformVersion>2023.1</platformVersion>
        <platformBuild>231.8109.175</platformBuild>

        <annotations.version>26.0.2</annotations.version>
        <junit.version>5.10.2</junit.version>

        <!-- 插件分发包内的根目录名（IDEA 要求 zip 结构为 <根>/lib/*.jar），ASCII 避免跨平台编码 -->
        <plugin.dist.dirName>dsh-pet-whale</plugin.dist.dirName>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    </properties>

    <repositories>
        <!-- IntelliJ Platform 官方制品仓库（com.jetbrains.intellij.* 全部来自这里） -->
        <repository>
            <id>intellij-platform-releases</id>
            <name>IntelliJ Platform Releases</name>
            <url>https://www.jetbrains.com/intellij-repository/releases</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <!-- IntelliJ Platform 制品的三方依赖（CDN 加速） -->
        <repository>
            <id>intellij-dependencies</id>
            <name>IntelliJ Platform Dependencies</name>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <!-- mirror-proof：绕开本机全局 settings.xml 中 mirrorOf=central 的失效 aliyun 镜像 -->
        <repository>
            <id>repo1</id>
            <name>Maven Central (repo1, mirror-proof)</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>repo1</id>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <!-- IntelliJ Platform API：全部 provided，运行期由 IDE 自身提供，绝不打进插件 jar -->
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>core</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>core-ui</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ide</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>ide-core</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>util</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>util-ui</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>extensions</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij.platform</groupId>
            <artifactId>project-model</artifactId>
            <version>${platformBuild}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 单元测试：JUnit 5 Jupiter + Vintage（兼容 JUnit 4 @Test/@Before/@After/@Rule） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>xml</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 --add-opens java.desktop/javax.swing=ALL-UNNAMED --add-opens java.desktop/sun.java2d=ALL-UNNAMED --add-opens java.desktop/java.awt=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED --add-opens java.desktop/java.beans=ALL-UNNAMED --add-opens java.desktop/com.sun.java.swing=ALL-UNNAMED</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Plugin-Name>${project.name}</Plugin-Name>
                            <Plugin-Version>${project.version}</Plugin-Version>
                            <Platform-Version>${platformVersion}</Platform-Version>
                            <Platform-Build>${platformBuild}</Platform-Build>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- 打包成 IntelliJ 可「Install Plugin from Disk」的 zip：
                 <根>/lib/<artifactId>-<version>.jar + 顶层 META-INF/plugin.xml 嵌在 jar 内 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <finalName>${project.artifactId}-${project.version}-plugin</finalName>
                    <descriptors>
                        <descriptor>src/assembly/plugin-distribution.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>build-plugin-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>